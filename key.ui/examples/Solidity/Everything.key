\profile "Solidity";

\javaSource ".";

\sorts {
    Memory;
    java.lang.Identity \extends java.lang.Object;
    IdentityPrim;
    Field;

	\generic alpha \extends any;

	Struct \extends any;
}


\functions{
    // Memory
    \unique Memory mtMem;

    Memory write(Memory, Identity, Field, any);
    Memory new(Memory, IdentityPrim);
    alpha alpha::read(Memory, Identity, Field);

    Identity idC(IdentityPrim, Seq);
    any defaultValue(Identity, Field);

    // Storage
    Struct save(Struct, Seq, any);
    alpha alpha::find(Struct, Seq);

    \unique Field size;
}

\schemaVariables{
    \term Memory mem;
    \term Identity id, id1, id2;
    \term IdentityPrim idp1, idp2;
    \term Field fld, fld1, fld2;
    \term Seq flds;
    \term alpha v;
}

\programVariables {
    Memory mem;
    Struct st;
}

\rules {
    readOnWrite {
        \find(alpha::read(write(mem, id1, fld1, v), id2, fld2))
        \replacewith( \if ( id1 = id2 & fld1 = fld2)
                      \then (v)
                      \else (alpha::read(mem, id2, fld2))
                    )
        \heuristics(simplify_enlarging)
    };

    readOnNew {
        \find(alpha::read(new(mem, idp1), idC(idp2, flds), fld))
            \replacewith(
                \if (idp1 = idp2) \then (
                        defaultValue(idC(idp2, flds), fld)
                ) \else (
                        alpha::read(mem, idC(idp2, flds), fld)
                )
        )
      \heuristics(simplify_enlarging)
    };

    readFromEmptyMemory {
        \find(alpha::read(mtMem, id, fld))
        \replacewith(defaultValue(id, fld))
        \heuristics(simplify)
    };
}

\programVariables {
    Memory mem;
    Identity id1, id2;
    IdentityPrim idp1, idp2;
    Seq flds;
    Field f1, f2;
}

\problem {
    true
    // int::read(write(mem, id1, f1, 0), id1, f1) = 0
    // idp1 != idp2 -> int::read(new(mem, idp1), idC(idp2, flds), f1) = int::read(mem, idC(idp2, flds), f1)
    // int::read(mtMem, id1, f1) = defaultValue(id1, f1)
}

