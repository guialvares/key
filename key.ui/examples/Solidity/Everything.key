\profile "Solidity";

\javaSource ".";

\sorts {
    Memory;
    java.lang.Identity \extends java.lang.Object;
    IdentityPrim;
    Field;

	\generic alpha \extends any;

	Struct \extends any;
}


\functions{
    // Memory
    \unique Memory mtMem;

    Memory write(Memory, Identity, Field, any);
    Memory addd(Memory, IdentityPrim);
    alpha alpha::read(Memory, Identity, Field);

    Identity idC(IdentityPrim, Seq);
    any default(Identity, Field);
    any defaultF(Field);

    // Storage
    \unique Struct mtSt;

    Struct storee(Struct, Field, any);
    Struct save(Struct, Seq, any);
    alpha alpha::selectt(Struct, Field);

    \unique Field size;
}

\predicates {
    new(Memory, IdentityPrim);
}

\schemaVariables{
    \term Memory mem;
    \term Identity id, id1, id2;
    \term IdentityPrim idp1, idp2;
    \term Field fld, fld1, fld2;
    \term Seq flds;
    \term any v, v0, v1;
    \term Memory mem;
    \term Struct st;
}

\programVariables {
}

\rules {
    // Memory
    readOnWrite {
        \find(alpha::read(write(mem, id1, fld1, v), id2, fld2))
        \replacewith( \if ( id1 = id2 & fld1 = fld2)
                      \then (v)
                      \else (alpha::read(mem, id2, fld2))
                    )
        \heuristics(simplify_enlarging)
    };

    readOnAddd {
        \find(alpha::read(addd(mem, idp1), idC(idp2, flds), fld))
            \replacewith(
                \if (idp1 = idp2) \then (
                        default(idC(idp2, flds), fld)
                ) \else (
                        alpha::read(mem, idC(idp2, flds), fld)
                )
        )
        \heuristics(simplify_enlarging)
    };

    readFromEmptyMemory {
        \find(alpha::read(mtMem, id, fld))
        \replacewith(default(id, fld))
        \heuristics(simplify)
    };

    newFromAdd {
        \find(new(addd(mem, idp1), idp2))
        \replacewith(
            \if (idp1 = idp2)
            \then (false)
            \else (new(mem, idp2))
        )
        \heuristics(simplify_enlarging)
    };

    newFromWrite {
        \find(new(write(mem, id1, fld1, v), idp2))
        \replacewith(new(mem, idp2))
        \heuristics(simplify_enlarging)
    };

    newFromEmptyMemory {
        \find(new(mtMem, idp1))
        \replacewith(true)
        \heuristics(simplify_enlarging)
    };

    // Storage
    selectOnStore {
        \find(alpha::selectt(storee(st, fld1, v), fld2))
        \replacewith(
            \if (fld1 = fld2)
            \then (v)
            \else (alpha::selectt(st,fld2))
        )
        \heuristics(simplify_enlarging)
    };

    selectOnEmptyStorage {
        \find(alpha::selectt(mtSt, fld))
        \replacewith(alpha::defaultF(fld) )
        \heuristics(simplify_enlarging)
    };

    saveOnEmptyStorage {
        \find(save(mtSt, flds, v))
        \replacewith(
            \if ( seqLen(flds) <= 0 )
            \then ( v )
            \else ( storee(mtSt, Field::seqGet(flds, 0), save(mtSt, seqSub(flds, 1, seqLen(flds)), v)) )
        )
        \heuristics(simplify_enlarging)
    };

    saveOnStore {
        \find(save(storee(st, fld, v0), flds, v1))
        \replacewith(
            \if ( seqLen(flds) <= 0 )
            \then ( v1 )
            \else (
                \if (fld = Field::seqGet(flds, 0))
                \then ( storee(st, fld,
                    \if ( seqLen(flds) <= 1 )
                    \then ( v1 )
                    \else ( save( (Struct)v0, seqSub(flds, 1, seqLen(flds)), v1) )
                ))
                \else ( storee(save(st, flds, v1), fld, v0) )
            )
        )
        \heuristics(simplify_enlarging)
    };
}

\programVariables {
    Memory mem;
    Identity id1, id2;
    IdentityPrim idp1, idp2;
    Seq flds;
    Field f1, f2;
    Seq s;
    alpha v;
}

\problem {
    // true
    f1 != f2 & flds = seqConcat(seqSingleton(f1), seqSingleton(f2)) ->

    // int::read(write(mem, id1, f1, 0), id1, f1) = 0
    // idp1 != idp2 -> int::read(addd(mem, idp1), idC(idp2, flds), f1) = int::read(mem, idC(idp2, flds), f1)
    // int::read(mtMem, id1, f1) = default(id1, f1)
    // int::selectt(storee(st, f1, 0), f1) = 0
    // f1 != f2 -> int::selectt(storee(st, f1, 0), f2) = int::selectt(st, f2)
    // int::selectt(mtSt, f1) = alpha::defaultF(f1)
    // ! new(addd(mem, idp1), idp1)
    // new(mem, idp2) -> new(write(mem, id1, f1, 0), idp2)
    // new(mtMem, idp1)
    // save(mtSt, flds, 0) = storee(mtSt, f1, storee(mtSt, f1, 0))
    // (int)save(mtSt, seqEmpty, 0) = 0
    // save(storee(mtSt, f1, 0), seqSingleton(f1), 1) = storee(mtSt, f1, 1)
    // save(storee(mtSt, f2, 0), seqSub(seqConcat(seqSingleton(f1), seqSingleton(f2)), 1, 2), 1) = storee(mtSt, f2, 1)
    save(storee(mtSt, f1, storee(mtSt, f2, 0)), flds, 1) = storee(mtSt, f1, storee(mtSt, f2, 1))
}

